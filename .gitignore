# Never commit personal workspace data into the public repo
*.docx
*.pdf
*.csv
*.json
!templates/**/*.json
!tests/evals/baselines/*.json
!examples/*/applications/*/ad.json
config.yaml
!templates/workspace/config.yaml
!examples/sample-workspace/config.yaml
!examples/sample-workspace-de/config.yaml
# Python and Office temp files
__pycache__/
.pytest_cache/
*.pyc
~$*
*.tmp
~build_*
